# ============================================================
#  india-mart-products-up  —  configuration
#  Copy this file to `.env` and fill in your values.
# ============================================================

# ---------- SEO text generation (DeepSeek, OpenAI-compatible) ----------
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model id. Official ids today: "deepseek-chat" (V3) or "deepseek-reasoner" (R1).
# Set to whatever you have access to (e.g. "deepseek-v4-pro" if/when available,
# or an OpenRouter id like "deepseek/deepseek-chat").
DEEPSEEK_MODEL=deepseek-chat

# ---------- AI image regeneration (faithful copy of the real photo) ----------
# Which provider recreates the downloaded image. One of: gemini | openai | replicate
IMAGE_PROVIDER=gemini
# Optional AI regeneration remains available; false uses processed real photos only.
IMAGE_AI=true

# ---------- Authorized non-AI watermark replacement ----------
# Comma-separated IndiaMART seller IDs whose source-image watermark you are
# authorized to replace. The seller ID is the folder before the image filename.
AUTHORIZED_IMAGE_SELLER_IDS=
REPLACE_AUTHORIZED_SOURCE_WATERMARK=false
# Text added to the bottom-right of authorized images after source-mark cleanup.
IMAGE_TEXT_WATERMARK=Om Shanti Medical

# ---------- Local upload background removal (optional) ----------
# The UI controls whether this is enabled. Processing uses rembg CPU with the
# lightweight u2netp model, one image at a time, and never overwrites sources.
# Normally the app auto-detects .venv-background-removal. Override only when
# using another Python 3.11-3.13 environment with the pinned requirements.
BACKGROUND_REMOVAL_PYTHON=

# Gemini (image-in -> image-out, good at "recreate this exact product")
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview

# OpenAI (used for gpt-image-1 edits; also works as a DeepSeek fallback client)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Replicate (Flux img2img / redux style faithful recreation)
REPLICATE_API_TOKEN=
# A model that accepts an input image. Override if you prefer another.
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro

# ---------- IndiaMART upload (Playwright) ----------
# Folder where the logged-in browser session is stored (created on `login`).
INDIAMART_SESSION_DIR=.session
INDIAMART_SELLER_URL=https://seller.indiamart.com/product/manageproducts/
# Run the browser visibly (true) or headless (false). Keep true for login/OTP.
HEADFUL=true
# Optional pre-scan that crawls every Active + Inactive product before each
# upload and skips name matches. Off: IndiaMART rejects duplicate names itself
# and the uploader already reconciles an exact existing item in place.
SKIP_EXISTING=false

# ---------- Scraper ----------
# Comma-separated IndiaMART listing/search/seller URLs to pull products from.
# You can also pass URLs on the CLI: `npm run scrape -- --url "<url>"`
SCRAPE_URLS=
# Max products to pull per run (0 = no limit)
SCRAPE_LIMIT=0

# ---------- Pipeline ----------
# Your own supplier details, injected into the generated SEO copy.
SUPPLIER_NAME=Om Shanti Medical
SUPPLIER_CITY=Nagpur
SUPPLIER_STATE=Maharashtra
# How many products to process in parallel for AI stages.
CONCURRENCY=3
