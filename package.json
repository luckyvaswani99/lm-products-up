{
  "name": "india-mart-products-up",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scrape products from IndiaMART, regenerate images + SEO copy with AI, and auto-upload them to your IndiaMART seller portal.",
  "bin": {
    "improd": "./src/cli.js"
  },
  "scripts": {
    "scrape": "node src/cli.js scrape",
    "images": "node src/cli.js images",
    "seo": "node src/cli.js seo",
    "upload": "node src/cli.js upload",
    "run": "node src/cli.js run-all",
    "login": "node src/cli.js login",
    "list": "node src/cli.js list",
    "web": "node src/server.js",
    "test": "node --test \"test/*.test.mjs\"",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "openai": "^4.67.0",
    "p-limit": "^6.1.0",
    "playwright": "^1.48.0",
    "replicate": "^1.0.1"
  },
  "engines": {
    "node": ">=18.17"
  }
}
